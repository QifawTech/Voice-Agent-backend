# ============================================================
# Production env — copy to .env.prod ON THE EC2 BOX ONLY.
# Never commit .env.prod. It is read by docker-compose.prod.yml
# at runtime and is deliberately excluded from the image.
# ============================================================

ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---- used by compose to wire postgres + build DATABASE_URL ----
POSTGRES_DB=voice_agent
POSTGRES_USER=voice_agent_user
POSTGRES_PASSWORD=          # generate: openssl rand -base64 32

# NOTE: DATABASE_URL and REDIS_URL are set by compose to point at the
# service names (postgres:5432 / redis:6379) — do not set them here.

# ---- EC2 ----
EC2_PUBLIC_IP=              # the instance's public/elastic IP (LiveKit needs it)

# ---- Security ----
SECRET_KEY=                 # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

CORS_ORIGINS=https://yourdomain.com

# ---- LiveKit (real keys, NOT devkey/secret) ----
LIVEKIT_API_KEY=            # openssl rand -hex 16
LIVEKIT_API_SECRET=         # openssl rand -base64 48

# ---- AI providers ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPGRAM_STT_MODEL=deepgram/nova-3
DEEPGRAM_TTS_MODEL=deepgram/aura-2-thalia-en

SARVAM_API_KEY=
