# ============================================
# Voice Agent Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Application ----
APP_NAME=Voice Agent Platform
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://voice_agent_user:voice_agent_pass_2026@localhost:5432/voice_agent

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Security ----
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- DeepSeek AI ----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Deepgram via OpenRouter (English STT/TTS) ----
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPGRAM_STT_MODEL=deepgram/nova-3
DEEPGRAM_TTS_MODEL=deepgram/aura-2-thalia-en

# ---- Sarvam AI (South Indian Languages STT/TTS) ----
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_SPEAKER=shreya

# ---- Encryption ----
ENCRYPTION_KEY=your-aes-256-encryption-key-must-be-32-bytes

# ---- LiveKit (Real-time Voice Agent) ----
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ---- Deepgram (Direct API — used by LiveKit agent for STT/TTS) ----
DEEPGRAM_API_KEY=your-deepgram-api-key
